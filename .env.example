# Google AI Studio / Gemini (preferred if set). Get a key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Alternative name (either works):
# GEMINI_API_KEY=

# Optional: force one model first (otherwise the app tries several, e.g. 2.5-flash-lite → 1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional fallback: OpenAI vision — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
